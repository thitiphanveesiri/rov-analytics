// RoV Pro Team Analytics — Database Schema (Multi-team version)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// ── Auth ──
model User {
  id               String    @id @default(cuid())
  email            String    @unique
  password         String
  name             String?
  createdAt        DateTime  @default(now())
  teamId           String?   // null = ยังไม่ได้เข้าทีม
  role             String    @default("member") // "admin" | "coach" | "member"
  team             Team?     @relation(fields: [teamId], references: [id])
  // Reset password
  resetToken       String?   @unique
  resetTokenExpiry DateTime?
}

// ── Team ──
model Team {
  id          String    @id @default(cuid())
  name        String
  inviteCode  String    @unique @default(cuid())
  createdAt   DateTime  @default(now())
  members     User[]
  data        TeamData?
}

// ── Team Data (1 row per team) ──
model TeamData {
  id            String   @id @default(cuid())
  teamId        String   @unique
  team          Team     @relation(fields: [teamId], references: [id])
  matches       Json     @default("[]")
  rivals        Json     @default("[]")
  roster        Json     @default("[\"Player 1\",\"Player 2\"]")
  enemyRosters  Json     @default("{}")
  scoutMatches  Json     @default("[]")
  playerPhotos  Json     @default("{}")
  heroPhotos    Json     @default("{}")
  customHeroes  Json     @default("[]")
  roleOverrides Json     @default("{}")
  videos        Json     @default("[]")
  updatedAt     DateTime @updatedAt
  updatedBy     String?
}
