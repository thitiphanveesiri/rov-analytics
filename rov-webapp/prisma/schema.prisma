// RoV Pro Team Analytics — Database Schema (Multi-team version)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// ── Auth ──
model User {
  id               String    @id @default(cuid())
  email            String    @unique
  password         String
  name             String?
  createdAt        DateTime  @default(now())
  teamId           String?   // null = ยังไม่ได้เข้าทีม
  role             String    @default("member") // "admin" | "coach" | "member"
  // "active" | "pending" — คนสร้างทีมใหม่ได้ active ทันที (เป็นคนแรกของทีม
  // ไม่มีใครให้รออนุมัติ) ส่วนคนเข้าทีมผ่าน invite code ต้องรอ admin ของทีม
  // นั้นกด "อนุมัติ" ก่อน ถึงจะเห็น/แก้ข้อมูลทีมได้ — ดู app/api/register และ
  // app/api/data สำหรับจุดที่เช็ค status นี้
  status           String    @default("active")
  playerName       String?   // ผูกกับชื่อใน roster เพื่อใช้หน้า "My Stats"
  team             Team?     @relation(fields: [teamId], references: [id])
  // Reset password
  resetToken       String?   @unique
  resetTokenExpiry DateTime?

  googleCalendar   GoogleCalendarConnection?
}

// ── Team ──
model Team {
  id          String    @id @default(cuid())
  name        String
  inviteCode  String    @unique @default(cuid())
  createdAt   DateTime  @default(now())
  members     User[]
  data        TeamData?
  auditLogs   AdminAuditLog[]
  matches     Match[]
  patchVersions PatchVersion[]
  calendarSyncs GoogleCalendarSync[]
  youtubeChannels YoutubeWatchChannel[]
  youtubeSyncedVideos YoutubeSyncedVideo[]
  youtubeKeywords String[] @default(["scrim", "ซ้อม"])
  activityLogs ActivityLog[]
}

// ── Content activity log (matches/roster/schedules edited — visible to
//    the whole team, not just admins) — separate from AdminAuditLog below,
//    which only covers membership actions (role changes, approvals).
model ActivityLog {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userEmail String
  summary   String   // human-readable, e.g. "เพิ่มแมตช์ 1 รายการ, แก้ไข roster ทีม"
  createdAt DateTime @default(now())

  @@index([teamId, createdAt])
}

// ── Admin action history (role changes, member removals) ──
model AdminAuditLog {
  id          String   @id @default(cuid())
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id])
  actorEmail  String   // admin who performed the action
  action      String   // "role_change" | "member_removed"
  targetEmail String?  // who the action was performed on
  detail      String?  // e.g. "member → admin"
  createdAt   DateTime @default(now())

  @@index([teamId, createdAt])
}

// ── Team Data (1 row per team) ──
// NOTE: this JSON blob remains the SOURCE OF TRUTH for the app UI — nothing
// here changes to avoid breaking the existing read/write flow the whole
// frontend depends on. The Match/Game/Pick tables below are a *derived,
// query-friendly copy* of match/scout data, kept in sync by lib/matchSync.js
// every time /api/data PUT succeeds (see that file for why "sync + rebuild"
// beats trying to diff JSON against relational rows).
model TeamData {
  id            String   @id @default(cuid())
  teamId        String   @unique
  team          Team     @relation(fields: [teamId], references: [id])
  matches       Json     @default("[]")
  rivals        Json     @default("[]")
  roster        Json     @default("[\"Player 1\",\"Player 2\"]")
  enemyRosters  Json     @default("{}")
  scoutMatches  Json     @default("[]")
  playerPhotos  Json     @default("{}")
  heroPhotos    Json     @default("{}")
  customHeroes  Json     @default("[]")
  roleOverrides Json     @default("{}")
  videos        Json     @default("[]")
  teamLogo      String?  // URL โลโก้ทีม (Vercel Blob)
  rivalLogos    Json     @default("{}") // { [rivalName]: URL }
  schedules     Json     @default("[]") // [{ id, date, time, rival, tournament, note, category }]
  patchInfo     Json     @default("{}") // { version, notes, updatedAt }
  heroTiers     Json     @default("{}") // { [heroName]: "S+"|"S"|"A"|"B"|"C" }
  practiceAssignments Json @default("[]") // [{ id, player, title, note, dueDate, done, createdAt, createdBy }]
  whiteboardElements   Json @default("[]") // Tactical Whiteboard current board (paths/arrows/hero markers/text)
  whiteboardFormations Json @default("[]") // saved named formation snapshots — [{ id, name, elements, mapUrl, createdAt }]
  whiteboardMapUrl     String? @db.Text // uploaded background map image — a Vercel Blob URL, not raw image data
  updatedAt     DateTime @updatedAt
  updatedBy     String?
}

// ══════════════════════════════════════════════════════════════
//  NORMALIZED MATCH DATA — added for analytics (win rate by hero/role,
//  draft/ban patterns, patch timeline). Additive only; does not replace
//  TeamData.matches. Rebuilt from that JSON on every save via matchSync.js,
//  so it's always a point-in-time mirror, not something edited directly.
// ══════════════════════════════════════════════════════════════

model Match {
  id         String   @id @default(cuid())
  teamId     String
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  sourceId   String   // the original client-generated `id` from TeamData.matches (Date.now()-based) — lets us re-sync idempotently
  rivalName  String?
  category   String   @default("scrim") // "scrim" | "tournament" | etc.
  date       DateTime
  note       String?
  createdAt  DateTime @default(now())
  games      Game[]

  @@unique([teamId, sourceId])
  @@index([teamId, date])
  @@index([teamId, rivalName])
}

model Game {
  id          String   @id @default(cuid())
  matchId     String
  match       Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  gameNo      Int      @default(1)
  result      String   // "WIN" | "LOSE" (from the perspective of "our" team)
  durationMin Float?   // normalized to decimal minutes via lib/duration.js durationToMinutes()
  objectives  Json?

  picks       Pick[]

  @@index([matchId])
}

model Pick {
  id        String  @id @default(cuid())
  gameId    String
  game      Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  side      String  // "our" | "enemy"
  isBan     Boolean @default(false)
  slotIdx   Int     // pick: 0-4 (role slot) — ban: 0-3 (ban order)
  hero      String
  role      String? // resolved role at sync time (resolveHeroRole) — denormalized on purpose so hero role changes don't rewrite history
  player    String?
  kills     Int?
  deaths    Int?
  assists   Int?
  damage    Int?
  gold      Int?

  @@index([gameId, side])
  @@index([hero])
  @@index([hero, isBan])
}

// ── Patch version history — needed for the "win rate vs patch" timeline.
// TeamData.patchInfo only tracks the *current* patch, so this table
// (populated via /api/admin/patch-versions) is what lets us map a match's
// date to "which patch was live when this was played".
model PatchVersion {
  id         String   @id @default(cuid())
  teamId     String
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  version    String   // e.g. "1.52"
  notes      String?
  effectiveFrom DateTime // patch goes live at this date; the *next* version's effectiveFrom is this one's implicit end
  createdAt  DateTime @default(now())

  @@index([teamId, effectiveFrom])
}

// ══════════════════════════════════════════════════════════════
//  GOOGLE CALENDAR SYNC
//  Each user connects their OWN Google account — schedules created in the
//  app get auto-pushed to every connected member's own calendar (each
//  person has their own copy/event, not one shared calendar). That's why
//  this is 2 tables: one for each user's OAuth tokens, one tracking which
//  Google event ID corresponds to which schedule item for which user (so
//  we know whether to create/update/delete on future syncs).
// ══════════════════════════════════════════════════════════════

model GoogleCalendarConnection {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  googleEmail  String   // connected Google account, shown in UI ("เชื่อมต่อกับ x@gmail.com")
  // Tokens stored encrypted (AES-256-GCM, see lib/googleCalendar.js) — never
  // store OAuth refresh tokens in plaintext, they're long-lived credentials.
  accessTokenEnc  String   @db.Text
  refreshTokenEnc String   @db.Text
  expiresAt       DateTime // access token expiry — refresh when past this
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Tracks the Google Calendar event created for a given (schedule item,
// user) pair, so future edits/deletes in the app update or remove the
// right event instead of creating duplicates every sync.
model GoogleCalendarSync {
  id            String   @id @default(cuid())
  teamId        String
  team          Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId        String   // whose Google Calendar this event lives in
  scheduleId    String   // the client-generated `id` (Date.now()) from TeamData.schedules
  googleEventId String   // Google Calendar's event id — needed to PATCH/DELETE later
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, scheduleId])
  @@index([teamId, scheduleId])
}

// ══════════════════════════════════════════════════════════════
//  YOUTUBE AUTO-IMPORT
//  Multiple team members can each add their own YouTube channel to a
//  watch list — since different people take turns Live-streaming scrims
//  from their personal channels, not one shared team channel. A cron job
//  polls every watched channel's uploads playlist periodically; any new
//  video whose title starts with one of Team.youtubeKeywords gets
//  auto-added to TeamData.videos.
// ══════════════════════════════════════════════════════════════

model YoutubeWatchChannel {
  id                String   @id @default(cuid())
  teamId            String
  team              Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId            String   // whose Google connection to poll with — has to be the channel owner's own token to see unlisted uploads
  channelId         String   // YouTube channel id (starts with "UC...")
  channelTitle      String?  // cached display name, shown in the admin UI
  uploadsPlaylistId String   // resolved once when the channel is added — saves a channels.list call on every poll
  addedByEmail      String   // display only
  createdAt         DateTime @default(now())

  @@unique([teamId, channelId])
}

// Tracks which YouTube videos have already been synced into a team's
// video library, so the cron job never adds the same video twice even
// across many polling runs.
model YoutubeSyncedVideo {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  youtubeId String
  createdAt DateTime @default(now())

  @@unique([teamId, youtubeId])
}
