# ── Copy this file to .env.local for local development ──
# In production, set these in the Vercel dashboard instead
# (Project → Settings → Environment Variables). Vercel Postgres
# auto-fills POSTGRES_PRISMA_URL and POSTGRES_URL_NON_POOLING
# for you when you connect the database — you usually only need
# to set NEXTAUTH_SECRET and NEXTAUTH_URL by hand.

# Postgres connection strings (auto-filled by Vercel when you
# connect a Vercel Postgres database to this project)
POSTGRES_PRISMA_URL=""
POSTGRES_URL_NON_POOLING=""

# NextAuth — generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Vercel Blob (photo/logo uploads) — auto-filled by Vercel when you
# connect a Blob store to this project. For local dev, copy the token
# from Project → Storage → your Blob store → .env.local tab.
BLOB_READ_WRITE_TOKEN=""

# Resend (password-reset emails) — required or "ลืมรหัสผ่าน" will fail
# silently. Get a free API key at https://resend.com/api-keys
RESEND_API_KEY=""

# Optional — enables real, shared rate limiting on /api/register and
# /api/auth/forgot-password across all serverless instances (Upstash
# free tier: https://upstash.com). Without these, rate limiting still
# works but only per-instance (weaker protection against brute force).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
